{
  "name": "websino",
  "version": "0.1.0",
  "private": true,
  "description": "A multiplayer web casino. Play money, provably fair, works offline.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @websino/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "build:offline": "pnpm --filter @websino/web build:offline",
    "verify": "pnpm -r typecheck && pnpm test && pnpm build",
    "start": "pnpm --filter @websino/server start"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
